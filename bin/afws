#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

find_skill_file() {
  local candidate
  for candidate in \
    "${REPO_DIR}/SKILL.md" \
    "${REPO_DIR}/.agents/skills/agent-friendly-web-stack/SKILL.md" \
    "${HOME}/.agents/skills/agent-friendly-web-stack/SKILL.md" \
    "${HOME}/.claude/skills/agent-friendly-web-stack/SKILL.md" \
    "$(pwd)/SKILL.md" \
    "$(pwd)/.agents/skills/agent-friendly-web-stack/SKILL.md"; do
    if [[ -f "${candidate}" ]]; then
      printf '%s\n' "${candidate}"
      return 0
    fi
  done
  return 1
}

pkg_read() {
  local file="$1"
  local expr="${2#.}"
  if command -v jq >/dev/null 2>&1; then
    jq -r ".${expr} // empty" "${file}" 2>/dev/null || true
  elif command -v bun >/dev/null 2>&1; then
    bun -e "const p=JSON.parse(require('fs').readFileSync('${file}','utf8'));const v='${expr}'.split('.').reduce((a,k)=>a?.[k],p);if(v!=null)console.log(v)" 2>/dev/null || true
  elif command -v node >/dev/null 2>&1; then
    node -e "const p=JSON.parse(require('fs').readFileSync('${file}','utf8'));const v='${expr}'.split('.').reduce((a,k)=>a?.[k],p);if(v!=null)console.log(v)" 2>/dev/null || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c "import json,functools; p=json.load(open('${file}')); v=functools.reduce(lambda a,k: a.get(k) if isinstance(a,dict) else None, '${expr}'.split('.'), p); print(v if v is not None else '')" 2>/dev/null || true
  fi
}

pkg_keys() {
  local file="$1"
  local field="${2#.}"
  if command -v jq >/dev/null 2>&1; then
    jq -r ".${field} // {} | keys[]" "${file}" 2>/dev/null || true
  elif command -v bun >/dev/null 2>&1; then
    bun -e "const p=JSON.parse(require('fs').readFileSync('${file}','utf8'));for(const k of Object.keys(p['${field}']||{}))console.log(k)" 2>/dev/null || true
  elif command -v node >/dev/null 2>&1; then
    node -e "const p=JSON.parse(require('fs').readFileSync('${file}','utf8'));for(const k of Object.keys(p['${field}']||{}))console.log(k)" 2>/dev/null || true
  elif command -v python3 >/dev/null 2>&1; then
    python3 -c "import json; p=json.load(open('${file}')); [print(k) for k in (p.get('${field}') or {}).keys()]" 2>/dev/null || true
  fi
}

pkg_has_dep() {
  local file="$1"
  local dep="$2"
  local deps=""
  if command -v jq >/dev/null 2>&1; then
    deps="$(jq -r '((.dependencies // {}) + (.devDependencies // {})) | keys[]' "${file}" 2>/dev/null || true)"
  elif command -v bun >/dev/null 2>&1; then
    deps="$(bun -e "const p=JSON.parse(require('fs').readFileSync('${file}','utf8'));const d=Object.assign({},p.dependencies,p.devDependencies);for(const k of Object.keys(d))console.log(k)" 2>/dev/null || true)"
  elif command -v node >/dev/null 2>&1; then
    deps="$(node -e "const p=JSON.parse(require('fs').readFileSync('${file}','utf8'));const d=Object.assign({},p.dependencies,p.devDependencies);for(const k of Object.keys(d))console.log(k)" 2>/dev/null || true)"
  elif command -v python3 >/dev/null 2>&1; then
    deps="$(python3 -c "import json; p=json.load(open('${file}')); d={}; d.update(p.get('dependencies') or {}); d.update(p.get('devDependencies') or {}); [print(k) for k in d.keys()]" 2>/dev/null || true)"
  fi
  printf '%s\n' "${deps}" | grep -Fxq "${dep}"
}

pad_line() {
  local text="$1"
  local width=48
  local stripped
  stripped="$(printf '%s' "${text}" | sed -E $'s/\x1B\\[[0-9;]*[mK]//g')"
  local len="${#stripped}"
  if ((len > width)); then
    local cut=$((width - 3))
    text="${stripped:0:cut}..."
    len="${#text}"
  fi
  local pad=$((width - len))
  if ((pad < 0)); then
    pad=0
  fi
  printf '│ %s%*s │\n' "${text}" "${pad}" ""
}

format_row() {
  local mark="$1"
  local name="$2"
  local detail="$3"
  local use_color="${4:-0}"
  local c_green="" c_red="" c_dim="" c_reset=""
  if ((use_color)); then
    c_green=$'\033[32m'
    c_red=$'\033[31m'
    c_dim=$'\033[2m'
    c_reset=$'\033[0m'
  fi
  local mark_colored="${mark}"
  if ((use_color)); then
    if [[ "${mark}" == "✓" ]]; then
      mark_colored="${c_green}✓${c_reset}"
    else
      mark_colored="${c_red}✗${c_reset}"
    fi
  fi
  local label_width=11
  local pad=$((label_width - ${#name}))
  local pad_spaces=""
  if ((pad > 0)); then
    pad_spaces="$(printf '%*s' "${pad}" "")"
  fi
  local content="${mark_colored} ${name}${pad_spaces} ${c_dim}${detail}${c_reset}"
  pad_line "${content}"
}

cmd_audit() {
  local target="${1:-.}"
  if [[ "${target}" == "--help" || "${target}" == "-h" ]]; then
    cmd_help audit
    return 0
  fi
  if [[ ! -d "${target}" ]]; then
    printf 'Error: directory not found: %s\n' "${target}" >&2
    exit 2
  fi
  target="$(cd "${target}" && pwd)"

  local pkg="${target}/package.json"
  if [[ ! -f "${pkg}" ]]; then
    printf 'Error: package.json not found in %s\n' "${target}" >&2
    exit 2
  fi

  local use_color=0
  if [[ -t 1 ]] || [[ "${FORCE_COLOR:-0}" == "1" ]]; then
    use_color=1
  fi

  local c_reset="" c_green="" c_red="" c_dim="" c_bold=""
  if ((use_color)); then
    c_reset=$'\033[0m'
    c_green=$'\033[32m'
    c_red=$'\033[31m'
    c_dim=$'\033[2m'
    c_bold=$'\033[1m'
  fi

  local drift_count=0
  local ok_count=0

  local rt_drift=()
  if [[ ! -f "${target}/bun.lock" && ! -f "${target}/bun.lockb" ]]; then
    rt_drift+=("missing bun.lock")
  fi
  local pkg_mgr
  pkg_mgr="$(pkg_read "${pkg}" '.packageManager')"
  if [[ ! "${pkg_mgr}" =~ ^bun@ ]]; then
    rt_drift+=("packageManager != bun@*")
  fi
  local node_eng
  node_eng="$(pkg_read "${pkg}" '.engines.node')"
  if [[ -z "${node_eng}" ]]; then
    rt_drift+=("missing engines.node")
  fi

  local all_drifts=()

  local rt_mark="✓" rt_detail=""
  if ((${#rt_drift[@]} == 0)); then
    ((ok_count++))
    rt_detail="bun.lock · bun · node LTS"
  else
    ((drift_count++))
    rt_mark="✗"
    rt_detail="${#rt_drift[@]} drift"
    for d in "${rt_drift[@]}"; do
      all_drifts+=("runtime: ${d}")
    done
  fi

  local fw_drift=()
  if [[ ! -d "${target}/app" ]]; then
    fw_drift+=("missing app/ directory")
  fi
  if [[ -d "${target}/pages" ]]; then
    fw_drift+=("pages/ router forbidden")
  fi
  if [[ -d "${target}/src" ]]; then
    fw_drift+=("src/ indirection forbidden")
  fi
  if [[ ! -f "${target}/next.config.ts" && ! -f "${target}/next.config.js" && ! -f "${target}/next.config.mjs" ]]; then
    fw_drift+=("missing next.config.ts")
  fi
  if ! pkg_has_dep "${pkg}" "next"; then
    fw_drift+=("next package not in dependencies")
  fi

  local fw_mark="✓" fw_detail=""
  if ((${#fw_drift[@]} == 0)); then
    ((ok_count++))
    fw_detail="next.js app router · no src/"
  else
    ((drift_count++))
    fw_mark="✗"
    fw_detail="${#fw_drift[@]} drift"
    for d in "${fw_drift[@]}"; do
      all_drifts+=("framework: ${d}")
    done
  fi

  local st_drift=()
  if ! pkg_has_dep "${pkg}" "@stylexjs/stylex"; then
    st_drift+=("missing @stylexjs/stylex")
  fi
  if pkg_has_dep "${pkg}" "tailwindcss"; then
    st_drift+=("tailwindcss forbidden")
  fi
  if pkg_has_dep "${pkg}" "styled-components" || pkg_has_dep "${pkg}" "@emotion/react"; then
    st_drift+=("competing css-in-js forbidden")
  fi
  if [[ ! -f "${target}/babel.config.js" && ! -f "${target}/babel.config.mjs" && ! -f "${target}/babel.config.json" ]]; then
    st_drift+=("missing babel.config.js")
  fi
  if [[ ! -f "${target}/postcss.config.js" && ! -f "${target}/postcss.config.mjs" && ! -f "${target}/postcss.config.json" ]]; then
    st_drift+=("missing postcss.config.js")
  fi

  local st_mark="✓" st_detail=""
  if ((${#st_drift[@]} == 0)); then
    ((ok_count++))
    st_detail="stylex · zero-runtime atomic css"
  else
    ((drift_count++))
    st_mark="✗"
    st_detail="${#st_drift[@]} drift"
    for d in "${st_drift[@]}"; do
      all_drifts+=("styling: ${d}")
    done
  fi

  local dt_drift=()
  if ! pkg_has_dep "${pkg}" "@supabase/supabase-js"; then
    dt_drift+=("missing @supabase/supabase-js")
  fi
  if ! pkg_has_dep "${pkg}" "@supabase/ssr"; then
    dt_drift+=("missing @supabase/ssr")
  fi
  if [[ ! -d "${target}/supabase/migrations" && ! -f "${target}/supabase/config.toml" ]]; then
    dt_drift+=("missing supabase/migrations")
  fi
  if [[ ! -f "${target}/proxy.ts" && ! -f "${target}/app/proxy.ts" ]]; then
    dt_drift+=("missing proxy.ts for auth refresh")
  fi

  local dt_mark="✓" dt_detail=""
  if ((${#dt_drift[@]} == 0)); then
    ((ok_count++))
    dt_detail="supabase ssr · sql migrations"
  else
    ((drift_count++))
    dt_mark="✗"
    dt_detail="${#dt_drift[@]} drift"
    for d in "${dt_drift[@]}"; do
      all_drifts+=("data: ${d}")
    done
  fi

  local canonical_scripts=(
    "setup" "dev" "build" "start" "typecheck" "lint"
    "format" "format:check" "test" "test:db" "test:smoke" "test:e2e"
    "db:start" "db:reset" "db:types" "check"
  )
  local script_keys
  script_keys="$(pkg_keys "${pkg}" "scripts")"

  local missing_scripts=()
  local s
  for s in "${canonical_scripts[@]}"; do
    if ! printf '%s\n' "${script_keys}" | grep -Fxq "${s}"; then
      missing_scripts+=("${s}")
    fi
  done

  local sc_mark="✓" sc_detail=""
  local present_count=$((16 - ${#missing_scripts[@]}))
  if ((${#missing_scripts[@]} == 0)); then
    ((ok_count++))
    sc_detail="16/16 canonical gates present"
  else
    ((drift_count++))
    sc_mark="✗"
    sc_detail="${#missing_scripts[@]} missing (${present_count}/16)"
    local IFS=", "
    all_drifts+=("scripts: missing ${missing_scripts[*]}")
  fi

  local ts_drift=()
  if ! pkg_has_dep "${pkg}" "vitest" && [[ ! -f "${target}/vitest.config.ts" && ! -f "${target}/vitest.config.mts" ]]; then
    ts_drift+=("missing vitest")
  fi
  if ! pkg_has_dep "${pkg}" "@playwright/test" && [[ ! -f "${target}/playwright.config.ts" ]]; then
    ts_drift+=("missing playwright")
  fi
  if ! pkg_has_dep "${pkg}" "@stylexjs/eslint-plugin"; then
    ts_drift+=("missing @stylexjs/eslint-plugin")
  fi

  local ts_mark="✓" ts_detail=""
  if ((${#ts_drift[@]} == 0)); then
    ((ok_count++))
    ts_detail="vitest · playwright · pgtap"
  else
    ((drift_count++))
    ts_mark="✗"
    ts_detail="${#ts_drift[@]} drift"
    for d in "${ts_drift[@]}"; do
      all_drifts+=("tests: ${d}")
    done
  fi

  printf '╭──────────────────────────────────────────────────╮\n'
  pad_line "● ● ●  afws · audit"
  printf '├──────────────────────────────────────────────────┤\n'
  pad_line ""
  pad_line "$ afws audit $(basename "${target}")"
  pad_line ""
  format_row "${rt_mark}" "runtime" "${rt_detail}" "${use_color}"
  format_row "${fw_mark}" "framework" "${fw_detail}" "${use_color}"
  format_row "${st_mark}" "styling" "${st_detail}" "${use_color}"
  format_row "${dt_mark}" "data" "${dt_detail}" "${use_color}"
  format_row "${sc_mark}" "scripts" "${sc_detail}" "${use_color}"
  format_row "${ts_mark}" "tests" "${ts_detail}" "${use_color}"
  pad_line ""
  if ((drift_count == 0)); then
    pad_line "${ok_count} ok · 0 drift · conforming to stack spec"
  else
    pad_line "${ok_count} ok · ${drift_count} drift · specification mismatch"
  fi
  pad_line ""
  printf '╰──────────────────────────────────────────────────╯\n'

  if ((drift_count > 0)); then
    printf '\nDrift details:\n'
    local item
    for item in "${all_drifts[@]}"; do
      printf '  %s•%s %s\n' "${c_red}" "${c_reset}" "${item}"
    done
    printf '\n'
    exit 1
  fi
  exit 0
}

update_package_scripts() {
  local pkg="$1"
  if command -v bun >/dev/null 2>&1; then
    bun -e "
const fs = require('fs');
const p = JSON.parse(fs.readFileSync('${pkg}', 'utf8'));
p.packageManager = p.packageManager || 'bun@1.3.14';
p.engines = Object.assign({ node: '>=22' }, p.engines);
p.scripts = Object.assign({}, p.scripts, {
  'setup': 'bunx playwright install chromium && supabase start',
  'dev': 'next dev',
  'build': 'next build',
  'start': 'next start',
  'typecheck': 'next typegen && tsc --noEmit',
  'lint': 'eslint .',
  'format': 'prettier --write .',
  'format:check': 'prettier --check .',
  'test': 'vitest run',
  'test:db': 'supabase test db',
  'test:smoke': 'node server.test.js',
  'test:e2e': 'playwright test',
  'db:start': 'supabase start',
  'db:reset': 'supabase db reset',
  'db:types': 'supabase gen types typescript --local > lib/database.types.ts',
  'check': 'bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run test:db && bun run test:e2e'
});
fs.writeFileSync('${pkg}', JSON.stringify(p, null, 2) + '\n');
"
  elif command -v node >/dev/null 2>&1; then
    node -e "
const fs = require('fs');
const p = JSON.parse(fs.readFileSync('${pkg}', 'utf8'));
p.packageManager = p.packageManager || 'bun@1.3.14';
p.engines = Object.assign({ node: '>=22' }, p.engines);
p.scripts = Object.assign({}, p.scripts, {
  'setup': 'bunx playwright install chromium && supabase start',
  'dev': 'next dev',
  'build': 'next build',
  'start': 'next start',
  'typecheck': 'next typegen && tsc --noEmit',
  'lint': 'eslint .',
  'format': 'prettier --write .',
  'format:check': 'prettier --check .',
  'test': 'vitest run',
  'test:db': 'supabase test db',
  'test:smoke': 'node server.test.js',
  'test:e2e': 'playwright test',
  'db:start': 'supabase start',
  'db:reset': 'supabase db reset',
  'db:types': 'supabase gen types typescript --local > lib/database.types.ts',
  'check': 'bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run test:db && bun run test:e2e'
});
fs.writeFileSync('${pkg}', JSON.stringify(p, null, 2) + '\n');
"
  fi
}

cmd_scaffold() {
  local target=""
  local dry_run=0
  local skip_install=0

  while (($# > 0)); do
    case "$1" in
      --help|-h)
        cmd_help scaffold
        return 0
        ;;
      --dry-run)
        dry_run=1
        shift
        ;;
      --skip-install)
        skip_install=1
        shift
        ;;
      -*)
        printf 'Error: unknown option "%s"\n\n' "$1" >&2
        cmd_help scaffold >&2
        exit 2
        ;;
      *)
        if [[ -z "${target}" ]]; then
          target="$1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "${target}" ]]; then
    printf 'Usage: afws scaffold <project-dir> [--dry-run] [--skip-install]\n' >&2
    exit 2
  fi

  if [[ -e "${target}" && ${dry_run} -eq 0 ]]; then
    printf 'Error: path already exists: %s\n' "${target}" >&2
    exit 1
  fi

  local cmd_create="bunx create-next-app@latest ${target} --ts --eslint --app --no-src-dir --no-tailwind --import-alias \"@/*\" --no-agents-md --use-bun --yes"
  local cmd_deps="bun add @stylexjs/stylex @supabase/supabase-js @supabase/ssr zod"
  local cmd_dev_deps="bun add -d @stylexjs/babel-plugin @stylexjs/eslint-plugin @stylexjs/postcss-plugin vitest @testing-library/react @testing-library/dom jsdom @playwright/test supabase prettier"
  local cmd_rm_readme="rm -f ${target}/README.md"

  if ((dry_run)); then
    printf 'Scaffold plan for %s:\n\n' "${target}"
    printf '1. %s\n' "${cmd_create}"
    printf '2. %s\n' "${cmd_rm_readme}"
    printf '3. cd %s && %s\n' "${target}" "${cmd_deps}"
    printf '4. cd %s && %s\n' "${target}" "${cmd_dev_deps}"
    printf '5. Configure StyleX (babel.config.js, postcss.config.js, app/globals.css)\n'
    printf '6. Configure Supabase (proxy.ts, supabase/migrations, supabase/config.toml)\n'
    printf '7. Configure Next.js (next.config.ts) and testing (vitest.config.ts, playwright.config.ts)\n'
    printf '8. Inject 16 canonical scripts and bun/node engines in package.json\n'
    return 0
  fi

  if ((skip_install)); then
    mkdir -p "${target}/app" "${target}/supabase/migrations"
    touch "${target}/bun.lock"
    cat <<'SKP_PKG' > "${target}/package.json"
{
  "name": "afws-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bunx playwright install chromium && supabase start",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:db": "supabase test db",
    "test:smoke": "node server.test.js",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/database.types.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run test:db && bun run test:e2e"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.19.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/eslint-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.6",
    "supabase": "^2.116.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
SKP_PKG
  else
    eval "${cmd_create}"
    eval "${cmd_rm_readme}"
    (
      cd "${target}"
      eval "${cmd_deps}"
      eval "${cmd_dev_deps}"
    )
    update_package_scripts "${target}/package.json"
  fi

  cat <<'STYLE_BABEL' > "${target}/babel.config.js"
module.exports = {
  presets: ['next/babel'],
  plugins: [
    [
      '@stylexjs/babel-plugin',
      {
        dev: process.env.NODE_ENV === 'development',
        runtimeInjection: false,
        genConditionalClasses: true,
        treeshakeCompensation: true,
        unstable_moduleResolution: {
          type: 'commonJS',
          rootDir: __dirname,
        },
      },
    ],
  ],
};
STYLE_BABEL

  cat <<'STYLE_POSTCSS' > "${target}/postcss.config.js"
module.exports = {
  plugins: {
    '@stylexjs/postcss-plugin': {
      include: ['app/**/*.{js,jsx,ts,tsx}'],
    },
  },
};
STYLE_POSTCSS

  cat <<'SUPA_PROXY' > "${target}/proxy.ts"
import { createServerClient } from '@supabase/ssr'
import { NextResponse, type NextRequest } from 'next/server'

export async function updateSession(request: NextRequest) {
  let supabaseResponse = NextResponse.next({
    request,
  })

  const supabase = createServerClient(
    process.env.NEXT_PUBLIC_SUPABASE_URL!,
    process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!,
    {
      cookies: {
        getAll() {
          return request.cookies.getAll()
        },
        setAll(cookiesToSet) {
          cookiesToSet.forEach(({ name, value }) => request.cookies.set(name, value))
          supabaseResponse = NextResponse.next({
            request,
          })
          cookiesToSet.forEach(({ name, value, options }) =>
            supabaseResponse.cookies.set(name, value, options)
          )
        },
      },
    }
  )

  await supabase.auth.getClaims()

  return supabaseResponse
}
SUPA_PROXY

  cat <<'NEXT_CONF' > "${target}/next.config.ts"
import type { NextConfig } from "next";

const nextConfig: NextConfig = {
  agentRules: false,
};

export default nextConfig;
NEXT_CONF

  cat <<'VITEST_CONF' > "${target}/vitest.config.ts"
import { defineConfig } from 'vitest/config'

export default defineConfig({
  test: {
    environment: 'jsdom',
  },
})
VITEST_CONF

  cat <<'PLAYWRIGHT_CONF' > "${target}/playwright.config.ts"
import { defineConfig, devices } from '@playwright/test'

export default defineConfig({
  testDir: './tests/e2e',
  fullyParallel: true,
  reporter: 'list',
  use: {
    baseURL: 'http://localhost:3000',
  },
  projects: [
    {
      name: 'chromium',
      use: { ...devices['Desktop Chrome'] },
    },
  ],
})
PLAYWRIGHT_CONF

  mkdir -p "${target}/supabase/migrations"
  cat <<'SUPA_CONF' > "${target}/supabase/config.toml"
project_id = "local"
SUPA_CONF

  printf '@stylex;\n' > "${target}/app/globals.css"

  printf '\nScaffold complete. Running audit...\n\n'
  cmd_audit "${target}"
}

cmd_spec() {
  local section="${1:-all}"
  if [[ "${section}" == "--help" || "${section}" == "-h" ]]; then
    cmd_help spec
    return 0
  fi

  local skill_file
  skill_file="$(find_skill_file)" || {
    printf 'Error: SKILL.md not found\n' >&2
    exit 2
  }

  case "${section}" in
    all)
      cat "${skill_file}"
      ;;
    stack|required)
      awk '/^## Required stack/{flag=1; next} /^## /{flag=0} flag' "${skill_file}"
      ;;
    next|app|architecture)
      awk '/^## Next.js architecture/{flag=1; next} /^## /{flag=0} flag' "${skill_file}"
      ;;
    stylex|styling)
      awk '/^## StyleX contract/{flag=1; next} /^## /{flag=0} flag' "${skill_file}"
      ;;
    cache|caching)
      awk '/^## Caching and data freshness/{flag=1; next} /^## /{flag=0} flag' "${skill_file}"
      ;;
    data|security|auth)
      awk '/^## Data and security boundaries/{flag=1; next} /^## /{flag=0} flag' "${skill_file}"
      ;;
    repo|scripts|contract)
      awk '/^## Reproducible repository contract/{flag=1; next} /^## /{flag=0} flag' "${skill_file}"
      ;;
    feedback|loop|verification)
      awk '/^## Feedback-loop contract/{flag=1; next} /^## /{flag=0} flag' "${skill_file}"
      ;;
    test|tests)
      awk '/^## Test contract/{flag=1; next} /^## /{flag=0} flag' "${skill_file}"
      ;;
    gate|completion)
      awk '/^## Completion gate/{flag=1; next} /^## /{flag=0} flag' "${skill_file}"
      ;;
    *)
      printf 'Unknown section: %s\n' "${section}" >&2
      printf 'Available: all, stack, next, stylex, cache, data, repo, scripts, feedback, test, gate\n' >&2
      exit 2
      ;;
  esac
}

cmd_install() {
  local mode="global"
  local dest_base=""
  while (($# > 0)); do
    case "$1" in
      --help|-h)
        cmd_help install
        return 0
        ;;
      --global)
        mode="global"
        shift
        ;;
      --local)
        mode="local"
        shift
        ;;
      --target)
        dest_base="$2"
        shift 2
        ;;
      -*)
        printf 'Error: unknown option "%s"\n\n' "$1" >&2
        cmd_help install >&2
        exit 2
        ;;
      *)
        dest_base="$1"
        shift
        ;;
    esac
  done

  local skill_file
  skill_file="$(find_skill_file)" || {
    printf 'Error: SKILL.md not found\n' >&2
    exit 2
  }

  local target_agents target_claude
  if [[ -n "${dest_base}" ]]; then
    mkdir -p "${dest_base}"
    dest_base="$(cd "${dest_base}" && pwd)"
    target_agents="${dest_base}/.agents/skills/agent-friendly-web-stack"
    target_claude="${dest_base}/.claude/skills/agent-friendly-web-stack"
  elif [[ "${mode}" == "global" ]]; then
    target_agents="${HOME}/.agents/skills/agent-friendly-web-stack"
    target_claude="${HOME}/.claude/skills/agent-friendly-web-stack"
  else
    target_agents="$(pwd)/.agents/skills/agent-friendly-web-stack"
    target_claude="$(pwd)/.claude/skills/agent-friendly-web-stack"
  fi

  mkdir -p "${target_agents}"
  cp "${skill_file}" "${target_agents}/SKILL.md"

  mkdir -p "$(dirname "${target_claude}")"
  rm -rf "${target_claude}"
  ln -s "../../.agents/skills/agent-friendly-web-stack" "${target_claude}"

  printf 'Installed agent-friendly-web-stack skill:\n'
  printf '  → %s/SKILL.md\n' "${target_agents}"
  printf '  → %s (symlink)\n' "${target_claude}"
}

cmd_help() {
  case "${1:-}" in
    audit)
      cat <<'EOF'
Usage: afws audit [path]

Audit a project directory against the stack contract.
Defaults to current directory when path is omitted.

Exit codes:
  0  Conforms to specification
  1  Drift or violation detected
  2  Usage error or missing path
EOF
      ;;
    scaffold)
      cat <<'EOF'
Usage: afws scaffold <project-dir> [--dry-run] [--skip-install]

Scaffold a new conforming Next.js project configured with StyleX and Supabase.

Options:
  --dry-run       Print scaffold commands without writing to disk
  --skip-install  Generate project files without installing dependencies
EOF
      ;;
    spec)
      cat <<'EOF'
Usage: afws spec [section]

View normative sections from SKILL.md.

Available sections:
  all, stack, next, stylex, cache, data, repo, scripts, feedback, test, gate
EOF
      ;;
    install)
      cat <<'EOF'
Usage: afws install [--global|--local] [--target <dir>]

Install the skill into agent discovery paths.

Options:
  --global        Install to user home (~/.agents/skills)
  --local         Install to current directory (./.agents/skills)
  --target <dir>  Install into specified directory
EOF
      ;;
    *)
      cat <<'EOF'
afws - Agent-Friendly Web Stack CLI

Usage:
  afws audit [path]              Audit a project directory against the stack contract
  afws scaffold <dir> [--dry-run] Scaffold a new conforming Next.js project
  afws spec [section]            View the normative specification or a section
  afws install [--global|--local] Install the skill into agent discovery paths
  afws help [command]            Display this help message

Exit codes:
  0  Conforms to specification
  1  Drift or violation detected
  2  Usage error or missing path
EOF
      ;;
  esac
}

main() {
  if [[ $# -eq 0 ]]; then
    cmd_help
    return 0
  fi

  local subcmd="$1"
  shift

  case "${subcmd}" in
    audit)
      cmd_audit "$@"
      ;;
    scaffold)
      cmd_scaffold "$@"
      ;;
    spec)
      cmd_spec "$@"
      ;;
    install)
      cmd_install "$@"
      ;;
    help|--help|-h)
      cmd_help "$@"
      ;;
    *)
      printf 'Error: unknown command "%s"\n\n' "${subcmd}" >&2
      cmd_help >&2
      exit 2
      ;;
  esac
}

main "$@"
